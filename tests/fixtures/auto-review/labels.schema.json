{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "auto-review-labels.schema.json",
  "title": "Automatic review evaluation corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["datasetVersion", "reviewerPolicy", "screenshots", "documents"],
  "properties": {
    "datasetVersion": { "type": "string", "minLength": 1 },
    "reviewerPolicy": { "type": "string", "minLength": 1 },
    "screenshots": {
      "type": "object",
      "required": ["figure-1.png", "figure-2.png", "figure-3.png"],
      "additionalProperties": { "$ref": "#/$defs/imageDigest" }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["documentId", "documentName", "items"],
        "properties": {
          "documentId": { "type": "string", "minLength": 1 },
          "documentName": { "type": "string", "minLength": 1 },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/item" }
          }
        }
      }
    }
  },
  "$defs": {
    "imageDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "sha256"],
      "properties": {
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" }
      }
    },
    "source": {
      "type": "object",
      "required": ["pageStart"],
      "properties": {
        "pageStart": { "type": "integer", "minimum": 1 },
        "pageEnd": { "type": "integer", "minimum": 1 },
        "tableId": { "type": "string", "minLength": 1 },
        "rowIndex": { "type": "integer", "minimum": 0 }
      }
    },
    "issueType": {
      "enum": [
        "reading_order_noise",
        "row_boundary_contamination",
        "column_misalignment",
        "merged_cell_scope_error",
        "missing_content",
        "source_mapping_error",
        "semantic_assignment_error",
        "other"
      ]
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "auditItemId",
        "partition",
        "reviewer",
        "reviewedAt",
        "evidence",
        "sourceImagePath",
        "sourceImageSha256",
        "parsedItem",
        "trueStatus",
        "severity",
        "issueTypes",
        "correctSource"
      ],
      "properties": {
        "auditItemId": { "type": "string", "minLength": 1 },
        "partition": { "enum": ["calibration", "blind"] },
        "reviewer": { "type": "string", "minLength": 1 },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "evidence": { "type": "string", "minLength": 1 },
        "sourceImagePath": { "type": "string", "minLength": 1 },
        "sourceImageSha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
        "parsedItem": { "type": "object" },
        "trueStatus": { "enum": ["issue", "clean"] },
        "severity": { "enum": ["severe", "non_severe", "none"] },
        "issueTypes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/issueType" } },
        "correctSource": { "$ref": "#/$defs/source" }
      }
    }
  }
}
